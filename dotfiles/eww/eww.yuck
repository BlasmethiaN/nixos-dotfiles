(defvar eww "eww")

(defpoll time :interval "10s"
  "date '+%a, %d %b %H:%M'")

(defpoll network :interval "10s"
  "scripts/network.sh")

(deflisten volume :initial "0" "scripts/volume.sh")

(deflisten media :initial "" "scripts/mediaplayer.sh")

(deflisten workspaces_mon1 :initial "[]" "scripts/workspaces.sh HDMI-A-1")
(deflisten workspaces_mon2 :initial "[]" "scripts/workspaces.sh DP-1")

;; --- WIDGETY ---

(defwidget network_widget []
  (eventbox :onclick "nm-connection-editor &"
    (box :class "module network"
         :space-evenly false
         (label :class "icon" 
                :text {network =~ "Wired" ? "󰈀 " : " "})
         (label :text network))))

(defwidget workspace_list [workspace_data]
  (box :class "module workspaces"
       :space-evenly false
       :valign "center"
       (for ws in workspace_data
         (button :onclick "hyprctl dispatch workspace ${ws.id}"
           (box :valign "center" 
                :halign "center"
                :class "dot ${ws.occupied ? 'occupied' : ''} ${ws.active ? 'active' : ''}")))))

(defwidget volume_widget []
  (eventbox :onscroll "echo {} | sed -e 's/up/--increase 5/g' -e 's/down/--decrease 5/g' | xargs pamixer"
            :class "volume-eventbox"
            :class "media-eventbox"
    (box :class "module" 
         :space-evenly false
         (label :class "icon" :text " ")
         (label :text "${volume}%"))))

(defwidget music []
  (eventbox :onscroll "echo {} | sed -e 's/up/next/g' -e 's/down/previous/g' | xargs playerctl"
            :onclick "playerctl play-pause"
    (box :class "module media"
         :orientation "h"
         :space-evenly false
         :visible {media != ""}
         (label :class "icon" :text "󰝚 ")
         (label :text media :limit-width 35))))

(defwidget right_modules []
  (box :orientation "h"
       :space-evenly false
       :halign "end"
       :spacing 10
       
       (volume_widget)

       (network_widget)

       (box :class "module clock"
            :space-evenly false
            (label :class "icon" :text " ")
            (label :text time))))

;; --- BAR ---
(defwindow bar_mon1
  :monitor 0
  :windowtype "dock"
  :geometry (geometry :x "0%" :y "10px" :width "98%" :height "52px" :anchor "top center")
  :exclusive true
  (box :class "main-container"
    (centerbox :orientation "h"
               :class "bar-inner"
      (box :halign "start" :space-evenly false :spacing 10 :valign "center"
           (workspace_list :workspace_data workspaces_mon1)
           (music))
      (box)
      (box :halign "end" :space-evenly false :spacing 10 :valign "center"
           (right_modules)))))

(defwindow bar_mon2
  :monitor 1
  :windowtype "dock"
  :geometry (geometry :x "0%" :y "10px" :width "98%" :height "40px" :anchor "top center")
  :exclusive true
  (box :class "main-container"
    (centerbox :orientation "h"
      (box :halign "start" :space-evenly false :spacing 10
           (workspace_list :workspace_data workspaces_mon2) ;; Správné předání dat
           (music))
      (box)
      (right_modules))))
